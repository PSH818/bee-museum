    {
      "key": "flower:flower-medicago-sativa",
      "kind": "flower",
      "id": "flower-medicago-sativa",
      "reviewStatus": "ai-reviewed",
      "name": "紫花苜蓿",
      "scientificName": "Medicago sativa",
      "englishName": "alfalfa / lucerne",
      "family": "豆科 Fabaceae",
      "form": "papilionaceous",
      "bloom": {
        "region-china-east": {
          "from": 5,
