  "entries": [
    {
      "key": "stage:cycle-apis-mellifera-worker/stage-mellifera-cleaner",
      "kind": "stage",
      "story": "一只工蜂的一生",
      "unit": "day",
      "id": "stage-mellifera-cleaner",
      "reviewStatus": "draft",
      "name": "清洁巢房",
      "short": "清洁",
      "phase": "adult",
      "span": {
        "from": 21,
        "to": 23
      },
      "spanText": "出房后第 1–2 天(自产卵起第 21–22 天)",
      "summary": "刚出房的工蜂最先做的是打扫:把用过的巢房清理干净,好让蜂王再次在里面产卵。",
      "detail": "工蜂一生的工作大致按年龄排班:先做巢内的活,再做巢外的活。不同资料给出的分段天数略有出入,这里按常见的分段标注,实际会随蜂群需要调整。",
      "related": [
        {
          "kind": "species",
          "id": "apis-mellifera",
          "label": "西方蜜蜂物种卡"
        }
      ],
      "sourceIds": [
        "src-wikipedia-worker-bee",
        "src-wikipedia-western-honey-bee"
      ]
    },
    {
      "key": "stage:cycle-apis-mellifera-worker/stage-mellifera-nurse",
      "kind": "stage",
      "story": "一只工蜂的一生",
      "unit": "day",
      "id": "stage-mellifera-nurse",
      "reviewStatus": "draft",
      "name": "哺育幼虫",
      "short": "哺育",
      "phase": "adult",
      "span": {
        "from": 23,
        "to": 33
      },
      "spanText": "出房后第 3–12 天(自产卵起第 23–32 天)",
      "summary": "哺育蜂用腺体分泌的乳状食物喂养工蜂幼虫(常称“工蜂浆”,与蜂王浆来自同一类腺体);其中一部分(约出房后第 7–11 天)也会给蜂王喂食、梳理体表。",
      "detail": "哺育蜂喂养幼虫约 6 天;幼虫自产卵起约第 9 天被封在巢房里,随后化蛹。",
      "related": [
        {
          "kind": "organ",
          "id": "organ-proboscis",
          "label": "口器"
        }
      ],
      "sourceIds": [
        "src-wikipedia-worker-bee",
        "src-wikipedia-western-honey-bee",
        "src-wikipedia-bee-brood"
      ]
    },
    {
      "key": "stage:cycle-apis-mellifera-worker/stage-mellifera-builder",
      "kind": "stage",
      "story": "一只工蜂的一生",
      "unit": "day",
      "id": "stage-mellifera-builder",
      "reviewStatus": "draft",
      "name": "筑巢与储存",
      "short": "筑巢",
      "phase": "adult",
      "span": {
        "from": 33,
        "to": 39
      },
      "spanText": "出房后第 13–18 天(自产卵起第 33–38 天)",
      "summary": "腹部的蜡腺开始分泌蜡片,工蜂用它筑造和修补巢房,并把外勤蜂带回的花蜜和花粉接手储存。",
      "detail": "花蜜在巢内经工蜂反复传递、加入酶并蒸发水分,最终酿成蜂蜜——这一段会在蜂蜜工坊里展开。场景中新造的巢房以浅色区分。",
      "related": [
        {
          "kind": "focus",
          "id": "abdomen",
          "label": "腹部"
        }
      ],
      "sourceIds": [
        "src-wikipedia-worker-bee",
        "src-wikipedia-western-honey-bee"
      ]
    },
    {
      "key": "stage:cycle-apis-mellifera-worker/stage-mellifera-guard",
      "kind": "stage",
      "story": "一只工蜂的一生",
      "unit": "day",
      "id": "stage-mellifera-guard",
      "reviewStatus": "draft",
      "name": "守卫巢门",
      "short": "守卫",
      "phase": "adult",
      "span": {
        "from": 39,
        "to": 42
      },
      "spanText": "出房后第 18–21 天(自产卵起第 38–41 天)",
      "summary": "螫针发育成熟后,一部分工蜂在巢门口值守,检查进出者、抵御入侵。",
      "detail": "一般认为并非每只工蜂都会经历守卫阶段;分工会随蜂群的需要调整,有的工蜂会提前或推后转为外勤。",
      "related": [
        {
          "kind": "organ",
          "id": "organ-sting",
          "label": "螫针"
        }
      ],
      "sourceIds": [
        "src-wikipedia-worker-bee"
      ]
    },
    {
      "key": "stage:cycle-apis-mellifera-worker/stage-mellifera-forager",
      "kind": "stage",
      "story": "一只工蜂的一生",
      "unit": "day",
      "id": "stage-mellifera-forager",
      "reviewStatus": "draft",
      "name": "外勤采集",
      "short": "采集",
      "phase": "adult",
      "span": {
        "from": 42,
        "to": 63
      },
      "spanText": "出房后第 21 天起(自产卵起约第 41 天起)",
      "summary": "此后工蜂离开巢内工作,成为外勤蜂:常飞到约 3 公里外(据记载有时更远)采集花蜜、花粉、蜂胶和水,直到生命结束。",
      "detail": "夏季工蜂通常只活 2–6 周;秋天出生的越冬蜂在巢内结团过冬,可活到约 20 周。除蜂王外,一个蜂群的工蜂大约每四个月就整体更替一遍。",
      "related": [
        {
          "kind": "organ",
          "id": "organ-corbicula",
          "label": "花粉筐"
        },
        {
          "kind": "focus",
          "id": "leg",
          "label": "六足"
        }
      ],
      "sourceIds": [
        "src-wikipedia-worker-bee",
        "src-wikipedia-western-honey-bee"
      ]
    }
  ]
}